# Sophia core backend / LangGraph
ANTHROPIC_API_KEY=
MEM0_API_KEY=
MEM0_BASE_URL=
STREAM_API_KEY=
STREAM_API_SECRET=
LANGGRAPH_URL=
SOPHIA_VOICE_SERVER_URL=
VOICE_SERVER_URL=

# Protected voice-service boundary and synthetic lab (production stays off
# until both the enable and kill-switch controls are deliberately changed).
SOPHIA_VOICE_INTERNAL_AUTH_REQUIRED=false
SOPHIA_VOICE_INTERNAL_AUTH_SECRET=
SOPHIA_VOICE_LAB_ENABLED=false
SOPHIA_VOICE_LAB_KILL_SWITCH=true
SOPHIA_VOICE_LAB_PROVISIONING_ENABLED=false
SOPHIA_VOICE_LAB_TEST_PRINCIPAL=
SOPHIA_VOICE_LAB_TEST_EMAIL=
SOPHIA_VOICE_LAB_TEST_NAME=Sophia Voice Lab
SOPHIA_VOICE_LAB_ENVIRONMENT=production
SOPHIA_VOICE_LAB_MAX_TTL_SECONDS=300
# Dedicated Better Auth browser session (30-120 minutes), deliberately longer
# than a single short-lived capability so a bounded run can rotate grants.
SOPHIA_VOICE_LAB_SESSION_TTL_SECONDS=3600
SOPHIA_VOICE_LAB_GRANT_SECRET=
SOPHIA_VOICE_LAB_CAPABILITY_SECRET=
# Versioned replay-tombstone HMAC keyring. Production requires the canonical
# JSON object; retain previous kids until every ledger row is past expiry.
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_ACTIVE_KID=v1
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_KEYS={"v1":""}
# Legacy single-key local-development fallback only.
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_SECRET=
# Gateway-only Better Auth cleanup DSN and Voice Lab recovery secret. They are
# independent from the frontend grant secret and Gateway↔Voice auth secret.
SOPHIA_VOICE_LAB_AUTH_DATABASE_URL=
SOPHIA_VOICE_LAB_RECOVERY_INTERNAL_SECRET=
# Key-separated product-service -> Gateway D02 freeze/settlement capability.
# Mount on the Voice Lab web service and Gateway only; never on the browser
# worker, MCP caller, or deployment controller.
SOPHIA_VOICE_LAB_D02_GATEWAY_CAPABILITY_SECRET=
# Gateway-authored D02 settlement receipt verification authority. The private
# key remains Gateway-only; the Voice Lab web service receives only this SPKI
# public key and its exact key identifier.
SOPHIA_VOICE_LAB_D02_SETTLEMENT_ED25519_PUBLIC_KEY_SPKI_BASE64=
SOPHIA_VOICE_LAB_D02_SETTLEMENT_AUTHORITY_KEY_ID=
# Canonical JSON key-id -> Ed25519 SPKI map. Retain rotated public keys until
# every receipt they signed has passed its immutable evidence purge deadline.
SOPHIA_VOICE_LAB_D02_SETTLEMENT_ED25519_PUBLIC_KEYRING_JSON={}
SOPHIA_VOICE_LAB_RETENTION_REAPER_REQUIRED=false
SOPHIA_VOICE_LAB_RETENTION_REAPER_INTERVAL_SECONDS=60
SOPHIA_VOICE_LAB_RETENTION_REAPER_BATCH_SIZE=25
SOPHIA_VOICE_LAB_DURABLE_EVIDENCE_REQUIRED=false

# Sophia artifact/link storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_BUILDER_BUCKET=
SOPHIA_SUPABASE_MIRROR_ALL=false

# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key
# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000

# Required for visual deliverables (image-generation, ppt-generation skills).
# Backed by OpenAI's gpt-image-2 model. Without this set, .pptx and image
# tasks fail fast (exit 2) rather than looping for ~21 minutes as they did
# under the prior Gemini-backed silent-failure path.
OPENAI_API_KEY=your-openai-api-key

# Gemini keys. Voice prefers GOOGLE_API_KEY, while video-generation currently
# reads GEMINI_API_KEY directly.
GEMINI_API_KEY=

# Voice runtime selector. Defaults to legacy_cascade. OpenAI/Gemini are
# experimental-only and require both this global gate plus the provider adapter
# flag below; leave false for normal local/prod voice sessions.
# SOPHIA_VOICE_RUNTIME_MODE=legacy_cascade
# SOPHIA_VOICE_EXPERIMENTAL_RUNTIME_ENABLED=false

# OpenAI GPT-Realtime-2 voice adapter (Phase 7 event-pump + Phase 8A browser
# WebRTC/server-sideband dogfood path). Off by default; normal browser voice
# sessions stay on legacy_cascade unless all gates are explicitly enabled.
# Experimental activation requires:
# SOPHIA_VOICE_RUNTIME_MODE=openai_realtime
# SOPHIA_VOICE_EXPERIMENTAL_RUNTIME_ENABLED=true
# SOPHIA_VOICE_OPENAI_REALTIME_ADAPTER_ENABLED=true
# OPENAI_API_KEY=your-openai-api-key
# Phase 8A browser flow mints ephemeral OpenAI client secrets on the backend;
# never put OPENAI_API_KEY in browser code or client-side env vars.
# SOPHIA_VOICE_OPENAI_REALTIME_ADAPTER_ENABLED=false
# SOPHIA_OPENAI_REALTIME_MODEL=gpt-realtime-2

# Gemini Live voice adapter (Phase 7 event-pump + Phase 8B browser Live
# WebSocket/backend-relay dogfood path). Off by default. The production
# /voice/connect route has one extra promotion flag so dogfood readiness does
# not automatically replace the legacy cascade.
# Experimental activation requires:
# SOPHIA_VOICE_RUNTIME_MODE=gemini_live
# SOPHIA_VOICE_EXPERIMENTAL_RUNTIME_ENABLED=true
# SOPHIA_VOICE_GEMINI_LIVE_ADAPTER_ENABLED=true
# Production /voice/connect promotion additionally requires:
# SOPHIA_VOICE_GEMINI_PRODUCTION_ROUTE_ENABLED=true
# GOOGLE_API_KEY=your-google-api-key  # or GEMINI_API_KEY=your-gemini-api-key
# Phase 8B browser flow mints ephemeral Google Live auth tokens on the backend;
# never put GOOGLE_API_KEY or GEMINI_API_KEY in browser code or client-side env vars.
# The browser opens Gemini Live WSS directly with the ephemeral token and relays
# server messages back for normalized Sophia observation.
# SOPHIA_VOICE_GEMINI_LIVE_ADAPTER_ENABLED=false
# SOPHIA_VOICE_GEMINI_PRODUCTION_ROUTE_ENABLED=false
# SOPHIA_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional Gemini prebuilt voice override for new Gemini Live sessions. Unset
# preserves the current explicit default, Kore. Invalid values fall back to Kore
# and are reported through safe gemini_voice_* bootstrap fields.
# Allowed: Zephyr, Puck, Charon, Kore, Fenrir, Leda, Orus, Aoede, Callirrhoe,
# Autonoe, Enceladus, Iapetus, Umbriel, Algieba, Despina, Erinome, Algenib,
# Rasalgethi, Laomedeia, Achernar, Alnilam, Schedar, Gacrux, Pulcherrima,
# Achird, Zubenelgenubi, Vindemiatrix, Sadachbia, Sadaltager, Sulafat.
# SOPHIA_GEMINI_LIVE_VOICE_NAME=Sulafat

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# VOLCENGINE_TTS_APPID=
# VOLCENGINE_TTS_ACCESS_TOKEN=
# VOLCENGINE_TTS_CLUSTER=volcano_tts
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_BOT_USERNAME=Sophia_EI_bot   # without the '@'; used to build t.me/<bot>?start=<token> deep links
# TELEGRAM_WORKER_BOT_TOKEN=your-telegram-worker-bot-token   # token for @Sophia_Work_bot — wired to the new telegram_work channel (Stage 1: Builder-as-Main DM)
# TELEGRAM_WORKER_BOT_USERNAME=Sophia_Work_bot                # without the '@'; used in user-facing prompts and the Stage-1 placeholder text

# Builder-as-Main Work bot (Stage 1, gated by channels.telegram_work.enabled in config.yaml).
# When the user DMs @Sophia_Work_bot, the new TelegramWorkChannel skips the
# companion graph entirely and dispatches directly to sophia_builder. The
# blocking response pattern uses placeholder edit (no streaming in Stage 1).
# Spec: docs/specs/sophia_builder_as_main_work_bot_spec.md.

# Telegram → web memory review handoff (Phase-2 of the async-migration / Telegram diagnostic spec).
# After a Telegram session goes idle for 10 minutes, the offline pipeline runs and
# the bot DMs the user a "memories ready" button. The button is a Telegram LoginUrl
# pointing at SOPHIA_WEB_BASE_URL/api/auth/telegram-login (HMAC verified by the
# frontend route using TELEGRAM_BOT_TOKEN). Requires the bot's domain to be
# registered with @BotFather /setdomain.
# SOPHIA_WEB_BASE_URL=https://app.sophia.com
# Kill switch: silence the new flow without redeploying.
# TELEGRAM_REVIEW_NOTIFICATIONS_ENABLED=true

# Builder completion notifier (PR-A).
# Tells the LangGraph process where to POST builder completion events so the
# Gateway worker can fan them out to webapp SSE / channel adapters. In local
# dev where both processes run on the same host, the default localhost URL
# is fine. In deployed environments (Render/Fly/Cloud Run) where LangGraph
# and Gateway run as separate services, MUST be set to the Gateway service's
# internal URL — otherwise completion cards (success + retry) are dropped.
# SOPHIA_GATEWAY_URL=http://localhost:8001
