# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth (required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Better Auth database (required when auth bypass is disabled)
# Better Auth in this frontend uses Postgres now, not SQLite.
# `frontend/pnpm-lock.yaml` may still mention `better-sqlite3` because Better Auth declares optional adapters.
# That lockfile entry is not evidence that the running app still depends on SQLite.
# Use only the restricted `better_auth_app` Supabase connection here. The
# postgres-owner migration DSN is shell-only and must never be deployed.
# BETTER_AUTH_DATABASE_URL=postgresql://better_auth_app:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL=
BETTER_AUTH_EXPECTED_SUPABASE_PROJECT_REF=
# Hosted Postgres providers like Supabase work with the default auto mode.
BETTER_AUTH_DATABASE_SSL_MODE=auto
# Current local default keeps the auth pool constrained for Supabase/serverless-style usage.
BETTER_AUTH_DATABASE_POOL_MAX=1
# Enable only during a coordinated Render/Vercel database cutover.
SOPHIA_MIGRATION_MAINTENANCE_MODE=false

# Google OAuth (required for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API URLs for local development
BACKEND_API_URL=http://localhost:8000
RENDER_BACKEND_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8001
SOPHIA_AUTH_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_SOPHIA_AUTH_BACKEND_URL=http://localhost:3000
SOPHIA_BACKEND_TOKEN_SECRET=
SOPHIA_LANGGRAPH_BASE_URL=http://127.0.0.1:2024
NEXT_PUBLIC_LANGGRAPH_BASE_URL=http://127.0.0.1:2024
SOPHIA_ASSISTANT_ID=sophia_companion
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local OAuth mode
# Set either bypass flag to true only when you want to skip Better Auth locally.
# Preferred auth flag. This takes precedence over NEXT_PUBLIC_DEV_BYPASS_AUTH.
NEXT_PUBLIC_SOPHIA_AUTH_BYPASS=false
# Legacy fallback flag. Keep false locally unless you explicitly want bypass mode.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
NEXT_PUBLIC_SOPHIA_USER_ID=dev-user

# Optional legacy/local frontend flags
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_BACKEND_WS_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERBOSE_LOGS=false
NEXT_PUBLIC_MOCK_PRIVACY=false
NEXT_PUBLIC_SESSIONS_PROXY_URL=
NEXT_PUBLIC_API_KEY=
BACKEND_API_KEY=
USE_MOCK_STREAMING=false
USE_MOCK_BOOTSTRAP=false
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Telegram login route, if enabled in frontend/Vercel
TELEGRAM_BOT_TOKEN=

# Local build/test flags
CAPACITOR_BUILD=false
SKIP_ENV_VALIDATION=false
SOPHIA_E2E_TEST_AUTH=false
PLAYWRIGHT_TEST_HOST=127.0.0.1
PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3000
E2E_BASE_URL=
PLAYWRIGHT_REUSE_EXISTING_SERVER=

# Protected autonomous voice lab. These controls are independent from
# SOPHIA_E2E_TEST_AUTH and are disabled + kill-switched by default.
SOPHIA_VOICE_LAB_ENABLED=false
SOPHIA_VOICE_LAB_KILL_SWITCH=true
SOPHIA_VOICE_LAB_PROVISIONING_ENABLED=false
SOPHIA_VOICE_LAB_TEST_PRINCIPAL=
SOPHIA_VOICE_LAB_TEST_EMAIL=
SOPHIA_VOICE_LAB_TEST_NAME=Sophia Voice Lab
SOPHIA_VOICE_LAB_ENVIRONMENT=production
SOPHIA_VOICE_LAB_MAX_TTL_SECONDS=300
# Bounded dedicated-principal browser session; accepted range is 1800-7200.
SOPHIA_VOICE_LAB_SESSION_TTL_SECONDS=3600
# HMAC secret shared only with the remote voice-lab grant issuer.
SOPHIA_VOICE_LAB_GRANT_SECRET=
# HMAC secret shared by frontend, gateway, and voice for exchanged capabilities.
SOPHIA_VOICE_LAB_CAPABILITY_SECRET=
# Versioned replay keyring; preserve old kids through max grant TTL + skew.
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_ACTIVE_KID=v1
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_KEYS={"v1":""}
# Legacy single-key local-development fallback only.
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_SECRET=
