    "github_actor_id",
    "github_created_at",
    "github_updated_at",
    "canonical_decision_payload"
  ],
  "canonical_decision_payload_exact_fields": [
    "schema_version",
    "record_type",
    "amendment_id",
    "approval_scope",
    "decision_id",
    "nonce",
    "approver_display_name",
    "approver_role",
