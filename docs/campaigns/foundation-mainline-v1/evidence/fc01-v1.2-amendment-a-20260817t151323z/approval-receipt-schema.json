    "governance_repository",
    "governance_issue_number",
    "expires_at",
    "unsigned_payload_bindings",
    "decision_statement",
    "designated_luis_github_login",
    "designated_luis_github_id",
    "evidence_operator"
  ],
  "evidence_operator_exact_fields": [
    "github_login",
    "github_id"
  ],
  "aggregate_receipt_exact_fields": [
    "schema_version",
    "record_type",
    "amendment_id",
    "approval_scope",
    "identity_assurance_method",
    "github_repository",
    "governance_issue_number",
    "seal_receipt_path",
    "seal_receipt_sha256",
    "davide_decision_path",
    "davide_decision_sha256",
    "luis_decision_path",
    "luis_decision_sha256",
    "joint_result",
    "evaluated_at",
    "approval_expires_at",
    "evidence_operator",
    "unsigned_payload_bindings",
    "fc01a_r_execution_authorized",
    "deployment_authorized",
    "baseline_frozen",
    "fc01b_started",
    "m00_started"
  ],
  "canonical_revocation_payload_exact_fields": [
    "schema_version",
    "record_type",
    "amendment_id",
    "decision_id",
    "decision_comment_id"
  ],
  "decision_values": {
    "schema_version": 1,
    "record_type": "FC01_AMENDMENT_DECISION_V1",
    "approval_scope": "FC01A_R_ONLY",
    "allowed_decisions": [
      "APPROVE",
      "REJECT"
    ],
    "required_roles": {
      "Davide": "OPERATIONAL_APPROVER",
      "Luis": "EXPERIENCE_ACCESSIBILITY_APPROVER"
    }
  },
  "time_contract": {
    "decision_time_source": "Fetched GitHub comment created_at",
    "decision_time_must_not_be_future": true,
    "decision_must_follow_seal": true,
    "decision_must_be_unexpired_at_evaluation": true,
    "decision_expires_at_must_not_exceed_repair_budget_expiry": true,
    "aggregate_evaluated_at_must_follow_both_decisions_and_not_be_future": true,
    "aggregate_approval_expires_at": "Minimum of both decision expirations and repair-budget expiration."
  },
  "revocation_contract": {
    "scan_scope": "All later comments on the same governance issue by the same fetched GitHub actor login and ID.",
    "canonical_record_type": "FC01_AMENDMENT_DECISION_REVOCATION_V1",
    "canonical_payload_uses_exact_fields_above": true,
    "matching_later_comment_result": "BLOCKED_REVOKED"
  },
  "aggregate_effect": {
    "joint_result_required": "APPROVED",
    "fc01a_r_execution_authorized": true,
    "deployment_authorized": false,
    "baseline_frozen": false,
    "fc01b_started": false,
    "m00_started": false,
    "evidence_operator_must_equal_both_comment_payloads": true
  },
  "failure_state_rules": {
    "missing_or_one_sided": "BLOCKED_AWAITING_JOINT_APPROVAL",
    "reject": "BLOCKED_REJECTED",
    "expired_or_budget_expired": "BLOCKED_EXPIRED",
    "revoked": "BLOCKED_REVOKED",
    "identity_or_github_access_failure": "BLOCKED_IDENTITY_ASSURANCE",
    "digest_binding_schema_or_git_drift": "BLOCKED_DIGEST_DRIFT",
    "execution_under_partial_approval": "PROHIBITED"
  },
  "approval_effect": "A valid aggregate changes only Amendment A to AMENDMENT_APPROVED and activates the still-immutable FC-01A-R budget. It does not authorize deployment, database/provider/credential mutation, BASELINE_FROZEN, FC-01B, or M00."
}
