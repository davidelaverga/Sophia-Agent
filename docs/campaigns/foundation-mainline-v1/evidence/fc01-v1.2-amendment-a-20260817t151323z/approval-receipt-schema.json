{
  "schema_version": 2,
  "amendment_id": "FC-01-v1.2-AMENDMENT-A",
  "current_state": "NO_DECISIONS_PRESENT",
  "execution_authorized": false,
  "decision_directory_pattern": "docs/campaigns/foundation-mainline-v1/evidence/fc01-v1.2-amendment-a-decisions-<YYYYMMDDtHHMMSSz>/",
  "github_issue_comment_identity": {
    "only_allowed_method": "GITHUB_ISSUE_COMMENT_V1",
    "governance_repository": "davidelaverga/Sophia-Agent",
    "same_governance_issue_required": true,
    "davide_actor_login": "davidelaverga",
    "davide_designates_luis_login_and_id": true,
    "davide_designates_evidence_operator": true,
    "luis_actor_and_payload_must_match_davide_designation": true,
    "comment_created_at_must_equal_updated_at": true,
    "github_created_at_is_authoritative_decision_time": true,
    "identity_source": "Read-only gh api responses for the exact issue, issue comment, actor, and full issue-comment listing.",
    "unavailable_or_unverifiable_result": "BLOCKED_IDENTITY_ASSURANCE"
  },
  "git_commit_protocol": {
    "required_branch": "campaign/fc01-control-v1",
    "clean_worktree_required": true,
    "seal_main_evaluator_replayed_at_current_clean_descendant": true,
    "decision_directory_must_be_governed_repo_path": true,
    "decision_sequence_commits": 3,
    "first_two_commits": "One additive Davide decision file and one additive Luis decision file, in either order.",
    "last_decision_sequence_commit": "One additive joint-approval-receipt.json; it must descend from both decision commits and remain an ancestor of current control HEAD.",
    "later_control_commits": "Permitted only as single-parent, add-only evidence commits outside the governed decision directory; they do not invalidate an otherwise-current approval.",
    "modification_deletion_rename_merge_or_non_evidence_path_allowed": false
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "json_object_keys": "lexicographically sorted",
    "separators": "comma and colon with no surrounding whitespace",
    "ensure_ascii": false,
    "trailing_newline": false,
    "body_rule": "Fetched GitHub comment body must byte-for-byte equal the canonical serialization of canonical_decision_payload."
  },
  "immutable_unsigned_payload_binding_keys": [
    "payload_commit",
    "payload_parent_commit",
    "payload_repository_tree",
    "payload_evidence_subtree",
    "payload_sha256sums_sha256",
    "amendment_document_sha256",
    "blocker_register_sha256",
    "authorized_scope_sha256",
    "repair_budget_sha256",
    "candidate_identity_budget_sha256",
    "main_evaluator_sha256",
    "approval_evaluator_sha256",
    "predecessor_control_head",
    "frozen_main_commit",
    "frozen_main_tree",
    "frozen_campaign_commit",
    "frozen_campaign_tree"
  ],
  "decision_record_exact_fields": [
    "schema_version",
    "record_type",
    "amendment_id",
    "identity_assurance_method",
    "github_repository",
    "github_issue_number",
