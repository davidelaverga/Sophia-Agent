# Sophia LangGraph Backend
FROM python:3.12-slim

ARG NODE_MAJOR=22

RUN apt-get update && apt-get install -y \
    curl build-essential gnupg ca-certificates \
    pandoc texlive-xetex texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended \
    lmodern fonts-dejavu-core libcairo2 libcairo2-dev libpango-1.0-0 libpangocairo-1.0-0 pkg-config \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN pandoc --version >/dev/null && xelatex --version >/dev/null

COPY --from=ghcr.io/astral-sh/uv:0.7.20 /uv /uvx /usr/local/bin/

WORKDIR /app
COPY backend ./backend
COPY config.production.yaml ./config.yaml
COPY skills ./skills

RUN --mount=type=cache,target=/root/.cache/uv \
    sh -c "cd backend && uv sync"

# Phase 4L: pre-install readabilipy's Node.js dependency (jsdom) at
# image build time. readabilipy's ``simple_json_from_html_string``
# lazy-triggers ``npm install`` via ``utils.py::run_npm_install`` on
# the first web_fetch call. But the upstream wheel ships a partial
# ``node_modules/jsdom/`` tree, which causes the lazy install to fail
# with ``ENOTEMPTY: directory not empty, rmdir '.../jsdom/lib/generated/idl'``
# and leaves ``jsdom/lib/api.js`` missing. Every subsequent web_fetch
# then falls back to pure-Python extraction (much lower content
# quality), which causes long-form research builds to loop on bad
# extractions until they hit the 30-turn force-emit ceiling.
#
# Wiping the partial node_modules and running a clean ``npm install``
# at build time guarantees the runtime ``have_node()`` check in
# ``readabilipy/simple_json.py`` finds a complete jsdom tree and
# skips the broken lazy install entirely.
RUN cd /app/backend/.venv/lib/python3.12/site-packages/readabilipy/javascript \
    && rm -rf node_modules \
    && npm install --no-audit --no-fund

ENV PYTHONPATH=.

# Phase 2A: --n-jobs-per-worker 10 unblocks concurrent runs across companion +
# builder threads. Without this flag, `langgraph dev` defaults to 1 (see
# `langgraph_api/cli.py:262-263`) AND explicitly overrides any external
# `N_JOBS_PER_WORKER` env var (`langgraph_api/cli.py:286`), so setting that
# env var on Render has no effect — the flag is the ONLY way to change it.
#
# Default 1 was the production-failure root cause confirmed in Render logs at
# 2026-05-20 19:43–19:54 UTC: a 10-min builder run held the only worker and
# the companion's mid-build update sat in queue for 7m 47s, tripping the
# gateway's runs.wait 5-min httpx ReadTimeout → user saw "An internal error
# occurred."
#
# N=10 matches the langgraph_api.config default. Cross-thread parallelism
# (builder thread + companion thread on the same shared worker pool) is what
# we gain; within-thread runs still serialize via LangGraph checkpoint locks.
CMD ["sh", "-c", "cd backend && uv run langgraph dev --host 0.0.0.0 --port ${PORT:-2024} --no-browser --allow-blocking --no-reload --n-jobs-per-worker 10"]
