# Backend / Gateway / LangGraph environment example.
# Placeholder values only. Do not commit real secrets.

# Core model and memory
ANTHROPIC_API_KEY=
MEM0_API_KEY=
MEM0_BASE_URL=
OPENAI_API_KEY=

# Optional web/search providers and dynamic config placeholders
TAVILY_API_KEY=
JINA_API_KEY=
INFOQUEST_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
NOVITA_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_API_KEY=

# Gateway service
CORS_ORIGINS=http://localhost:3000
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
VOICE_SERVER_URL=http://localhost:8000
SOPHIA_AUTH_BACKEND_URL=http://127.0.0.1:3000
BACKEND_API_URL=http://localhost:8000
SOPHIA_AUTH_BYPASS=false
SOPHIA_USER_ID=local-dev-user

# LangGraph / config
LANGGRAPH_URL=http://localhost:2024
SOPHIA_LANGGRAPH_BASE_URL=http://127.0.0.1:2024
SOPHIA_BACKEND_BASE_URL=
SOPHIA_GATEWAY_URL=http://localhost:8001
SOPHIA_BUILDER_MODEL=
BUILDER_PROGRESS_EMIT=true
DEER_FLOW_CONFIG_PATH=
DEER_FLOW_EXTENSIONS_CONFIG_PATH=
DEER_FLOW_SANDBOX_HOST=
DEER_FLOW_HOST_SKILLS_PATH=
DEER_FLOW_HOST_BASE_DIR=
DEER_FLOW_HOME=

# Sophia PPTX image generation defaults
SOPHIA_IMAGE_GEN_TIMEOUT=120
SOPHIA_IMAGE_GEN_MAX_RETRIES=1
SOPHIA_IMAGE_GEN_CONCURRENCY=2
SOPHIA_DECK_IMAGE_BATCH_TIMEOUT=

# Fresh PPTX execution budget (shared by graph and deck subprocesses)
SOPHIA_BUILDER_PRESENTATION_BUDGET_MAX_NON_ARTIFACT_TURNS=12
SOPHIA_BUILDER_PRESENTATION_BUDGET_FORCE_EMIT_REMAINING_TURNS=2
SOPHIA_BUILDER_PRESENTATION_BUDGET_SOFT_WARN_AT_TURN=6
SOPHIA_BUILDER_PRESENTATION_BUDGET_MAX_WALL_CLOCK_SECONDS=480
SOPHIA_BUILDER_PRESENTATION_BUDGET_PREPARE_FORCE_AT_TURN=8
SOPHIA_BUILDER_PRESENTATION_BUDGET_PREPARE_FORCE_AFTER_SECONDS=120

# Stream / voice token routes
STREAM_API_KEY=
STREAM_API_SECRET=

# Telegram channel and review handoff
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SOPHIA_WEB_BASE_URL=http://localhost:3000
TELEGRAM_REVIEW_NOTIFICATIONS_ENABLED=true
SOPHIA_TELEGRAM_BINDINGS_TABLE=telegram_user_bindings

# Supabase artifact/link storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_BUILDER_BUCKET=sophia-builder-artifacts
SOPHIA_SUPABASE_MIRROR_ALL=false

# LangSmith / LangChain tracing
LANGSMITH_TRACING=false
SOPHIA_BUILDER_LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Sophia
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT_UUID=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=
