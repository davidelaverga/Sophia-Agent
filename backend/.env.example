# Backend / Gateway / LangGraph environment example.
# Placeholder values only. Do not commit real secrets.

# Core model and memory
ANTHROPIC_API_KEY=
MEM0_API_KEY=
MEM0_BASE_URL=
OPENAI_API_KEY=

# Optional web/search providers and dynamic config placeholders
TAVILY_API_KEY=
JINA_API_KEY=
INFOQUEST_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
NOVITA_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_API_KEY=

# Gateway service
CORS_ORIGINS=http://localhost:3000
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
VOICE_SERVER_URL=http://localhost:8000
SOPHIA_AUTH_BACKEND_URL=http://127.0.0.1:3000
BACKEND_API_URL=http://localhost:8000
SOPHIA_AUTH_BYPASS=false
SOPHIA_USER_ID=local-dev-user

# Gateway -> voice internal authentication. Render requires this and fails
# closed if the shared secret is absent or malformed.
SOPHIA_VOICE_INTERNAL_AUTH_REQUIRED=false
SOPHIA_VOICE_INTERNAL_AUTH_SECRET=

# Protected synthetic voice lab. Independent from SOPHIA_AUTH_BYPASS.
SOPHIA_VOICE_LAB_ENABLED=false
SOPHIA_VOICE_LAB_KILL_SWITCH=true
SOPHIA_VOICE_LAB_TEST_PRINCIPAL=
SOPHIA_VOICE_LAB_ENVIRONMENT=production
SOPHIA_VOICE_LAB_MAX_TTL_SECONDS=300
SOPHIA_VOICE_LAB_CAPABILITY_SECRET=
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_ACTIVE_KID=v1
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_KEYS={"v1":""}
# Legacy single-key local-development fallback only.
SOPHIA_VOICE_LAB_AUTH_TOMBSTONE_SECRET=
SOPHIA_VOICE_LAB_AUTH_DATABASE_URL=
SOPHIA_VOICE_LAB_RECOVERY_INTERNAL_SECRET=
# D02 product settlement uses a dedicated least-privilege Gateway database
# role/DSN. The HMAC and Ed25519 private authorities are Gateway-only; Voice
# Lab receives only the capability secret and current public verification key.
SOPHIA_VOICE_LAB_D02_GATEWAY_DATABASE_URL=
SOPHIA_VOICE_LAB_D02_GATEWAY_CAPABILITY_SECRET=
# Gateway and the owner-only migration operator share this distinct finalize
# HMAC authority. It is never exposed to Voice Lab web, browser, MCP, or worker.
SOPHIA_VOICE_LAB_D02_DATABASE_FINALIZE_HMAC_KEY_ID=d02-db-finalize-v1
SOPHIA_VOICE_LAB_D02_DATABASE_FINALIZE_HMAC_SECRET=
SOPHIA_VOICE_LAB_D02_SETTLEMENT_IDENTITY_HMAC_SECRET=
SOPHIA_VOICE_LAB_D02_SETTLEMENT_ED25519_PRIVATE_KEY_PKCS8_BASE64=
SOPHIA_VOICE_LAB_D02_SETTLEMENT_ED25519_PUBLIC_KEY_SPKI_BASE64=
SOPHIA_VOICE_LAB_D02_SETTLEMENT_AUTHORITY_KEY_ID=
# Canonical JSON map of retained authority key IDs to SPKI base64. Keep old
# public keys through the longest unpurged D02 receipt retention deadline.
SOPHIA_VOICE_LAB_D02_SETTLEMENT_ED25519_PUBLIC_KEYRING_JSON={}
# Product-owned retention reaper. Production/Render requires this regardless
# of the lab enable or kill-switch state.
SOPHIA_VOICE_LAB_RETENTION_REAPER_REQUIRED=false
SOPHIA_VOICE_LAB_RETENTION_REAPER_INTERVAL_SECONDS=60
SOPHIA_VOICE_LAB_RETENTION_REAPER_BATCH_SIZE=25
# Production finalization must create an immutable Supabase evidence receipt.
SOPHIA_VOICE_LAB_DURABLE_EVIDENCE_REQUIRED=false

# LangGraph / config
LANGGRAPH_URL=http://localhost:2024
SOPHIA_LANGGRAPH_BASE_URL=http://127.0.0.1:2024
SOPHIA_BACKEND_BASE_URL=
SOPHIA_GATEWAY_URL=http://localhost:8001
SOPHIA_BUILDER_MODEL=
BUILDER_PROGRESS_EMIT=true
DEER_FLOW_CONFIG_PATH=
DEER_FLOW_EXTENSIONS_CONFIG_PATH=
DEER_FLOW_SANDBOX_HOST=
DEER_FLOW_HOST_SKILLS_PATH=
DEER_FLOW_HOST_BASE_DIR=
DEER_FLOW_HOME=

# Sophia PPTX image generation defaults
SOPHIA_IMAGE_GEN_TIMEOUT=120
SOPHIA_IMAGE_GEN_MAX_RETRIES=1
SOPHIA_IMAGE_GEN_CONCURRENCY=2
SOPHIA_DECK_IMAGE_BATCH_TIMEOUT=

# Fresh PPTX execution budget (shared by graph and deck subprocesses)
SOPHIA_BUILDER_PRESENTATION_BUDGET_MAX_NON_ARTIFACT_TURNS=12
SOPHIA_BUILDER_PRESENTATION_BUDGET_FORCE_EMIT_REMAINING_TURNS=2
SOPHIA_BUILDER_PRESENTATION_BUDGET_SOFT_WARN_AT_TURN=6
SOPHIA_BUILDER_PRESENTATION_BUDGET_MAX_WALL_CLOCK_SECONDS=1200
SOPHIA_BUILDER_PRESENTATION_BUDGET_PREPARE_FORCE_AT_TURN=2
SOPHIA_BUILDER_PRESENTATION_BUDGET_PREPARE_FORCE_AFTER_SECONDS=15
SOPHIA_BUILDER_PRESENTATION_BUDGET_AUTHORING_DEADLINE_SECONDS=720
SOPHIA_BUILDER_PRESENTATION_BUDGET_PREFLIGHT_TIMEOUT_SECONDS=15
SOPHIA_BUILDER_PRESENTATION_BUDGET_AUTHORING_MAX_TOKENS=16384
SOPHIA_BUILDER_PRESENTATION_AUTHORING_TIMEOUT_SECONDS=360
SOPHIA_BUILDER_PRESENTATION_BUDGET_TERMINAL_RESERVE_SECONDS=30

# Stream / voice token routes
STREAM_API_KEY=
STREAM_API_SECRET=

# Telegram channel and review handoff
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SOPHIA_WEB_BASE_URL=http://localhost:3000
TELEGRAM_REVIEW_NOTIFICATIONS_ENABLED=true
SOPHIA_TELEGRAM_BINDINGS_TABLE=telegram_user_bindings

# Supabase artifact/link storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_BUILDER_BUCKET=sophia-builder-artifacts
SOPHIA_EXPECTED_SUPABASE_PROJECT_REF=
SOPHIA_SUPABASE_MIRROR_ALL=false

# Ordinary Builder LangSmith / LangChain tracing. Protected synthetic Builder
# runs override this before client, run, feedback, and trusted-subprocess
# allocation and report `synthetic_isolation_policy` instead.
LANGSMITH_TRACING=false
SOPHIA_BUILDER_LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Sophia
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT_UUID=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=
