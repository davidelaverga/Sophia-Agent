# Sophia voice server environment example.
# Placeholder values only. Do not commit real secrets.

# Required for legacy_cascade voice runtime
STREAM_API_KEY=
STREAM_API_SECRET=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
SOPHIA_VOICE_ID=

# DeerFlow backend connection
SOPHIA_BACKEND_MODE=deerflow
SOPHIA_LANGGRAPH_BASE_URL=http://127.0.0.1:2024
SOPHIA_ASSISTANT_ID=sophia_companion
SOPHIA_PLATFORM=voice
SOPHIA_CONTEXT_MODE=life
SOPHIA_RITUAL=
SOPHIA_AGENT_USER_ID=sophia-agent
SOPHIA_AGENT_USER_NAME=Sophia

# Voice provider tuning
SOPHIA_DEEPGRAM_MODEL=flux-general-en
SOPHIA_DEEPGRAM_LANGUAGE=
SOPHIA_CARTESIA_MODEL=sonic-3
SOPHIA_CARTESIA_SAMPLE_RATE=16000
SOPHIA_SMART_TURN_SILENCE_MS=1200
SOPHIA_SMART_TURN_SPEECH_THRESHOLD=0.6
SOPHIA_SMART_TURN_PRE_SPEECH_BUFFER_MS=200
SOPHIA_SMART_TURN_VAD_RESET_SECONDS=5.0
SOPHIA_BACKEND_TIMEOUT_SECONDS=20.0
SOPHIA_READINESS_TIMEOUT_SECONDS=5.0
SOPHIA_ADAPTIVE_SILENCE_SHORT_MS=600
SOPHIA_ADAPTIVE_SILENCE_MEDIUM_MS=800
SOPHIA_ADAPTIVE_SILENCE_LONG_MS=1200
SOPHIA_ADAPTIVE_SILENCE_CEILING_MS=1400
SOPHIA_ADAPTIVE_SILENCE_CONTINUATION_BONUS_MS=300
SOPHIA_ADAPTIVE_SILENCE_FRAGMENT_BONUS_MS=500
SOPHIA_BACKEND_STALL_TIMEOUT_MS=8000
SOPHIA_FRAGILE_WINDOW_MS=600
SOPHIA_MERGE_MIN_NEW_WORDS=2
SOPHIA_RHYTHM_MIN_SESSIONS=5
SOPHIA_RHYTHM_BASE_MIN_MS=800
SOPHIA_RHYTHM_BASE_MAX_MS=2400
SOPHIA_SAME_TURN_REPEAT_DEBOUNCE_MS=1200

# Experimental realtime runtime gates
SOPHIA_VOICE_RUNTIME_MODE=legacy_cascade
SOPHIA_VOICE_EXPERIMENTAL_RUNTIME_ENABLED=false
SOPHIA_VOICE_OPENAI_REALTIME_ADAPTER_ENABLED=false
SOPHIA_OPENAI_REALTIME_MODEL=gpt-realtime-2
SOPHIA_VOICE_GEMINI_LIVE_ADAPTER_ENABLED=false
SOPHIA_VOICE_GEMINI_PRODUCTION_ROUTE_ENABLED=false
SOPHIA_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
SOPHIA_GEMINI_LIVE_CONTINUITY_ENABLED=false
SOPHIA_GEMINI_LIVE_COMPRESSION_ENABLED=false
# Default-on canary controls. Set either one to false independently.
SOPHIA_GEMINI_LIVE_GOOGLE_SEARCH_ENABLED=true
SOPHIA_GEMINI_LIVE_WEB_FETCH_ENABLED=true
SOPHIA_VOICE_REALTIME_SHADOW_PARITY_ENABLED=false
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional Gemini Live LangSmith observability (strictly fail-open)
SOPHIA_GEMINI_LIVE_LANGSMITH_TRACING=false
SOPHIA_GEMINI_LIVE_LANGSMITH_PROJECT=Sophia-Gemini-Live-Voice
SOPHIA_GEMINI_LIVE_TRACE_SCHEMA=sophia_gemini_live_trace_v2
SOPHIA_GEMINI_LIVE_TRACE_CONTENT_MODE=structural
SOPHIA_GEMINI_LIVE_AUDIO_CAPTURE_ENABLED=false
SOPHIA_VOICE_OBSERVABILITY_HMAC_SECRET=
SOPHIA_DEPLOYMENT_SHA=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

# Local shim/testing only
SOPHIA_SHIM_RESPONSE_TEXT=
SOPHIA_SHIM_CHUNK_DELAY_MS=40
SOPHIA_SHIM_FAILURE_STAGE=
SOPHIA_SHIM_FAILURE_MESSAGE=
SOPHIA_SHIM_EMIT_INVALID_ARTIFACT=false

# Legacy aliases kept only for migration/backward compatibility
SOPHIA_LLM_MODE=
SOPHIA_BACKEND_BASE_URL=
SOPHIA_BUFFER_IN_SECONDS=
SOPHIA_CONFIDENCE_THRESHOLD=
